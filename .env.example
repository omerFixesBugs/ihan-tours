# Copy to .env.local for local development (or run `vercel env pull .env.local`).

# Shared password for /admin (the developer and the client both use it).
ADMIN_PASSWORD=

# Long random string that signs admin login cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Vercel Blob read-write token; added automatically when the Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
